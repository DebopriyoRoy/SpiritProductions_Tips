# Postgres. Use a POOLED connection string in production:
#   Neon     …-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#   Supabase port 6543 (the transaction pooler), not 5432
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Square — one token covers BOTH locations; location is a filter, not a login.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2025-05-21
SQUARE_LOCATION_SPIRIT=
SQUARE_LOCATION_ACC=

# Leave unset to run against the built-in demo provider (no credentials needed).

# Only for `npm run create-admin` — not needed by the running app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
