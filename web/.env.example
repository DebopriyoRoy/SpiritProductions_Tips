# Postgres connection string. REQUIRED — the app will not start without it.
#
#   Local Postgres:
#     DATABASE_URL=postgresql://postgres@127.0.0.1:5432/spirit_tips
#
#   Neon (no install needed) — copy the POOLED string, the one with "-pooler":
#     DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb
#
#   Supabase: use port 6543 (the transaction pooler), not 5432.
#
# Leave this blank rather than guessing; a wrong value fails with a clear message.
DATABASE_URL=

# Square — one token covers BOTH locations; location is a filter, not a login.
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2025-05-21
SQUARE_LOCATION_SPIRIT=
SQUARE_LOCATION_ACC=

# Leave unset to run against the built-in demo provider (no credentials needed).

# Lets the /setup page create the FIRST administrator from a browser.
# Only works while no account exists. Remove it once you are set up.
SETUP_SECRET=

# Only for `npm run create-admin` — not needed by the running app.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# --- Email (Gmail SMTP) -------------------------------------------------
# Used to send password-reset codes and sign-in-address reminders.
#
# Gmail will NOT accept the account password here. On the sending Google
# account: turn on 2-Step Verification, then Google Account -> Security ->
# App passwords, and generate one for "Mail". It is 16 characters; paste it
# WITHOUT the spaces Google shows.
#
#   SMTP_USER=info@spiritofnewfoundland.com
#   SMTP_PASS=abcdefghijklmnop
#
# Leave SMTP_USER/SMTP_PASS blank and codes are printed to the server log
# instead of emailed, which is fine locally. In production that is refused.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# What recipients see in From. Defaults to SMTP_USER.
SMTP_FROM=Spirit Tips <info@spiritofnewfoundland.com>
